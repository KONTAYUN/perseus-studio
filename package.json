    "@tiptap/starter-kit": "^3.32.0",
    "lucide-react": "^0.525.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-textarea-autosize": "^8.5.9",
