# Copy to .env and adjust values before running.

# ── Core paths (Docker defaults shown; change for local dev) ──
BACKEND_ADDR=:8080
BACKEND_DB_PATH=/data/app.db
FRONTEND_DIST=/app/dist

# Per-user data root (workspaces, uploads, skills stored under /data/users/<user_id>/).
USER_DATA_ROOT=/data/users

# ── Debug and diagnostics ──
# Keep disabled for normal deployments. When enabled, debug endpoints still require admin login.
ENABLE_DEBUG_API=false

# ── Background task worker ──
TASK_WORKER_COUNT=2
# TASK_POLL_INTERVAL=1500ms
# BACKEND_SHUTDOWN_TIMEOUT=10s

# ── Auth ──
# Auto-create admin user on first startup (optional).
# PERSEUS_ADMIN_USERNAME=admin
# PERSEUS_ADMIN_PASSWORD=changeme

# ── Docker build ──
# Keep docker.io by default, or set a compatible registry mirror.
IMAGE_REGISTRY=docker.io
# APP_VERSION=dev
# APP_COMMIT=unknown
# APP_BUILT_AT=unknown
